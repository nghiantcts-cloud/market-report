# Đổi tên file này thành ".env" rồi điền thông tin.

# --- Gửi email (ví dụ Gmail: bật xác minh 2 bước, tạo "Mật khẩu ứng dụng") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ban@gmail.com
SMTP_PASS=mat-khau-ung-dung-16-ky-tu
MAIL_FROM=ban@gmail.com
